// Skema database Pixel Matrix — sesuai ARCHITECTURE.md §4.
//
// Catatan penting soal cakupan: seluruh persistensi di sini OPSIONAL. Kalau
// DATABASE_URL tidak diset, game berjalan persis seperti sebelumnya (room di
// memori, high score solo di localStorage). Itu bukan kompromi sementara —
// syarat "teman bisa langsung main tanpa daftar" berlaku selamanya, jadi
// database tidak boleh pernah menjadi prasyarat untuk bermain.

generator client {
  provider = "prisma-client-js"
  // Output eksplisit di dalam paket ini: di monorepo pnpm, generate ke
  // node_modules global bikin hasilnya tergantung cara hoisting.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Akun (Fase 3) — model Account/Session/VerificationToken mengikuti NextAuth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  /// Nama tampilan. Unik supaya bisa dipakai di leaderboard tanpa ambigu.
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Didenormalisasi supaya profil bisa dibaca tanpa agregasi ke SoloScore.
  soloHighScore Int       @default(0)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  soloScores   SoloScore[]
  matchPlayers MatchPlayer[]

  @@index([soloHighScore])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Riwayat permainan
// ---------------------------------------------------------------------------

model SoloScore {
  id String @id @default(cuid())

  userId String
  score  Int
  /// Dipakai validasi heuristik: skor tinggi dengan durasi mustahil ditolak.
  gameDurationSeconds Int
  /// Level tertinggi yang dicapai — berguna untuk balancing, bukan cuma pajangan.
  levelReached        Int      @default(1)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Match {
  id String @id @default(cuid())

  roomCode  String
  /// Pengaturan room saat match berjalan (maxPlayers, targetScore, timeLimit).
  settings  Json
  /// Kenapa match berakhir: targetScore | timeUp | suddenDeath.
  endReason String
  startedAt DateTime
  endedAt   DateTime

  players MatchPlayer[]

  @@index([roomCode, endedAt])
}

model MatchPlayer {
  id      String @id @default(cuid())
  matchId String

  /// Nullable dan SENGAJA: guest tetap tercatat sebagai bagian sejarah match.
  /// Kalau kolom ini wajib, seluruh match yang dimainkan tanpa login akan
  /// hilang dari riwayat — padahal itu justru cara main yang paling umum.
  userId    String?
  nickname  String
  avatar    String
  score     Int
  rank      Int
  accuracy  Float
  bestCombo Int
  /// Berapa kali nyawanya habis sepanjang match.
  knockouts  Int     @default(0)
  /// Tereliminasi sebelum match usai; selalu diperingkat di bawah yang bertahan.
  eliminated Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
}
