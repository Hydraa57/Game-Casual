// Skema database Pixel Matrix — sesuai ARCHITECTURE.md §4.
//
// Catatan penting soal cakupan: seluruh persistensi di sini OPSIONAL. Kalau
// DATABASE_URL tidak diset, game berjalan persis seperti sebelumnya (room di
// memori, high score solo di localStorage). Itu bukan kompromi sementara —
// syarat "teman bisa langsung main tanpa daftar" berlaku selamanya, jadi
// database tidak boleh pernah menjadi prasyarat untuk bermain.

generator client {
  provider = "prisma-client-js"
  // Output eksplisit di dalam paket ini: di monorepo pnpm, generate ke
  // node_modules global bikin hasilnya tergantung cara hoisting.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Akun — username + password, TANPA OAuth
// ---------------------------------------------------------------------------
//
// Sengaja tidak memakai login Google/Discord: game ini baru, dan meminta orang
// menautkan akun Google-nya ke game yang belum mereka percayai adalah friksi
// yang jauh lebih besar daripada mengisi dua kolom. Guest tetap bisa main
// penuh; akun hanya menambah riwayat yang tersimpan.

model User {
  id String @id @default(cuid())

  /// Nama tampilan apa adanya, termasuk besar-kecil hurufnya.
  username String @unique
  /// Versi huruf kecil, dipakai untuk keunikan.
  ///
  /// Dijadikan kolom tersendiri dan bukan sekadar pencarian case-insensitive
  /// supaya keunikannya dijaga DATABASE. Dengan cek-lalu-insert di aplikasi,
  /// dua pendaftaran bersamaan bisa lolos berdua — lalu "Budi" dan "budi"
  /// hidup berdampingan di leaderboard dan orang bisa menyamar jadi temannya.
  usernameLower String @unique
  /// scrypt: "salt:hash" heksadesimal. TIDAK PERNAH berisi password polos.
  passwordHash String
  /// Avatar default pemain saat masuk room.
  avatar String @default("fox")
  /// Belum dipakai. Ada supaya pemulihan password bisa ditambahkan tanpa
  /// migrasi yang menyakitkan — tanpa email, lupa password = akun hilang.
  email String? @unique

  /// Didenormalisasi supaya profil dan leaderboard bisa dibaca tanpa agregasi.
  soloHighScore Int      @default(0)
  createdAt     DateTime @default(now())

  sessions     Session[]
  soloScores   SoloScore[]
  matchPlayers MatchPlayer[]

  @@index([soloHighScore])
}

model Session {
  id String @id @default(cuid())

  /// Token acak 32 byte. Yang disimpan di cookie httpOnly milik pemain.
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Riwayat permainan
// ---------------------------------------------------------------------------

model SoloScore {
  id String @id @default(cuid())

  userId String
  score  Int
  /// Dipakai validasi heuristik: skor tinggi dengan durasi mustahil ditolak.
  gameDurationSeconds Int
  /// Level tertinggi yang dicapai — berguna untuk balancing, bukan cuma pajangan.
  levelReached        Int      @default(1)
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Match {
  id String @id @default(cuid())

  roomCode  String
  /// Pengaturan room saat match berjalan (maxPlayers, targetScore, timeLimit).
  settings  Json
  /// Kenapa match berakhir: targetScore | timeUp | suddenDeath.
  endReason String
  startedAt DateTime
  endedAt   DateTime

  players MatchPlayer[]

  @@index([roomCode, endedAt])
}

model MatchPlayer {
  id      String @id @default(cuid())
  matchId String

  /// Nullable dan SENGAJA: guest tetap tercatat sebagai bagian sejarah match.
  /// Kalau kolom ini wajib, seluruh match yang dimainkan tanpa login akan
  /// hilang dari riwayat — padahal itu justru cara main yang paling umum.
  userId    String?
  nickname  String
  avatar    String
  score     Int
  rank      Int
  accuracy  Float
  bestCombo Int
  /// Berapa kali nyawanya habis sepanjang match.
  knockouts  Int     @default(0)
  /// Tereliminasi sebelum match usai; selalu diperingkat di bawah yang bertahan.
  eliminated Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
}
