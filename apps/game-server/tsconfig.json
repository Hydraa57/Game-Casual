{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  // Skrip simulasi ikut di-typecheck. Sebelumnya tidak, dan akibatnya nyata:
  // `sim-bot.mts` menyusun `GameConfig`-nya sendiri lalu melewatkan
  // `spawnCrowdFactor` yang belakangan ditambahkan, sehingga papannya tidak
  // pernah memunculkan pixel — skripnya tetap mencetak tabel, tapi seluruh
  // angkanya sampah. Alat ukur yang diam-diam salah lebih berbahaya daripada
  // tidak punya alat ukur.
  "include": ["src/**/*.ts", "scripts/**/*.mts"]
}
